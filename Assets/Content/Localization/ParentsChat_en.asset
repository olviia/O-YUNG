  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ParentsChat_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 215eba5e3776fb6459f436f5df41337e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1079783424
    m_Localized: We're finally home.
    m_Metadata:
      m_Items: []
  - m_Id: 1125920768
    m_Localized: Home at last. Careful on the step.
    m_Metadata:
      m_Items: []
  - m_Id: 1130115072
    m_Localized: Did you lock the car?
    m_Metadata:
      m_Items: []
  - m_Id: 1130115073
    m_Localized: I think so.
    m_Metadata:
      m_Items: []
  - m_Id: 1130115074
    m_Localized: I'll check later.
    m_Metadata:
      m_Items: []
  - m_Id: 1130115075
    m_Localized: Look, the little one is yawning.
    m_Metadata:
      m_Items: []
  - m_Id: 1130115076
    m_Localized: That's the tiniest yawn I've ever seen.
    m_Metadata:
      m_Items: []
  - m_Id: 1130115077
    m_Localized: Is it warm enough in here?
    m_Metadata:
      m_Items: []
  - m_Id: 1130115078
    m_Localized: Feel those little hands.
    m_Metadata:
      m_Items: []
  - m_Id: 1130115079
    m_Localized: Should I get another blanket?
    m_Metadata:
      m_Items: []
  - m_Id: 1134309376
    m_Localized: Just one more.
    m_Metadata:
      m_Items: []
  - m_Id: 1134309377
    m_Localized: When did you last sleep?
    m_Metadata:
      m_Items: []
  - m_Id: 1134309378
    m_Localized: What's sleep?
    m_Metadata:
      m_Items: []
  - m_Id: 1134309379
    m_Localized: I vaguely remember it.
    m_Metadata:
      m_Items: []
  - m_Id: 1134309380
    m_Localized: Who do you think that nose is from?
    m_Metadata:
      m_Items: []
  - m_Id: 1134309381
    m_Localized: Your side, definitely.
    m_Metadata:
      m_Items: []
  - m_Id: 1134309382
    m_Localized: Poor kid.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503680
    m_Localized: Did you bring the bag in?
    m_Metadata:
      m_Items: []
  - m_Id: 1138503681
    m_Localized: Which bag?
    m_Metadata:
      m_Items: []
  - m_Id: 1138503682
    m_Localized: The one with everything in it.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503683
    m_Localized: I'll be right back.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503684
    m_Localized: It's so quiet here.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503685
    m_Localized: Enjoy it while it lasts.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503686
    m_Localized: Your mother called again.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503687
    m_Localized: What did you tell her?
    m_Metadata:
      m_Items: []
  - m_Id: 1138503688
    m_Localized: That everyone is fine.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503689
    m_Localized: Are we fine?
    m_Metadata:
      m_Items: []
  - m_Id: 1138503690
    m_Localized: We're managing.
    m_Metadata:
      m_Items: []
  - m_Id: 1138503691
    m_Localized: We still need a name.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697984
    m_Localized: We have time.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697985
    m_Localized: That's what you said last month.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697986
    m_Localized: They say never wake a sleeping baby.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697987
    m_Localized: And when the baby wakes us?
    m_Metadata:
      m_Items: []
  - m_Id: 1142697988
    m_Localized: Then we're on our own.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697989
    m_Localized: Those tiny socks.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697990
    m_Localized: One is already gone.
    m_Metadata:
      m_Items: []
  - m_Id: 1142697991
    m_Localized: How? We've been home an hour.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
